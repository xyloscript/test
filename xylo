local function setupDragging(header,main)
    if not Arqel.Options.Draggable then return end
    local dragging,dragStart,startPos,dragInput
    header.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            dragging=true; dragStart=input.Position; startPos=main.Position; dragInput=input
            input.Changed:Connect(function() if input.UserInputState==Enum.UserInputState.End then if dragInput==input then dragging=false dragInput=nil end end end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging or not dragInput then return end
        if input.UserInputType==Enum.UserInputType.MouseMovement or input==dragInput then
            local d=input.Position-dragStart
            local xS = startPos.X.Scale
            local xO = startPos.X.Offset + d.X
            local yS = startPos.Y.Scale
            local yO = startPos.Y.Offset + d.Y
            main.Position=UDim2.new(xS, xO, yS, yO)
        end
    end)
end

