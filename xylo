local function keyId(k) return (tostring(k):gsub("[^A-Z0-9]", "")) end

local function fbGet(path)
    local ok, res = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(FB_URL .. path .. ".json"))
    end)
    if ok then return res end
    return nil
end

local function fbPut(path, data)
    local r = http_request or request or (syn and syn.request) or (fluxus and fluxus.request)
    if not r then return false end
    local ok, res = pcall(function()
        return r({
            Url = FB_URL .. path .. ".json",
            Method = "PUT",
            Headers = {["Content-Type"]="application/json"},
            Body = HttpService:JSONEncode(data)
        })
    end)
    return ok
end

local function parseISO(iso)
    local y,mo,d,h,mi,s = iso:match("(%d+)-(%d+)-(%d+)T(%d+):(%d+):(%d+)")
    if not y then return nil end
    return os.time({year=tonumber(y),month=tonumber(mo),day=tonumber(d),hour=tonumber(h),min=tonumber(mi),sec=tonumber(s)})
end

local function verifyKey(key, isRedeem)
    if not key or key == "" then return false, "No key" end
    if not key:find("^XYLO%-") then return false, "Invalid key format" end
    local id = keyId(key)
    local rec = fbGet("/keys/" .. id)
    if not rec or not rec.key then return false, "Key not found in database" end
    if rec.revoked then return false, "Key revoked by admin" end
    if rec.expiry then
        local expT = parseISO(rec.expiry)
        if expT and os.time() > expT + 8*3600 then return false, "Key expired" end
    end
    if isRedeem then
        if rec.hwid and rec.hwid ~= "" and rec.hwid ~= HWID then
            return false, "Key bound to another device. Ask admin to reset HWID."
        end
        if not rec.hwid or rec.hwid == "" then rec.hwid = HWID end
        if rec.maxUses and rec.maxUses > 0 then
            if (rec.uses or 0) >= rec.maxUses then return false, "Max uses reached" end
        end
        rec.uses = (rec.uses or 0) + 1
        fbPut("/keys/" .. id, rec)
        return true, "OK"
    else
        if rec.hwid and rec.hwid ~= "" and rec.hwid ~= HWID then
            return false, "HWID mismatch"
        end
        return true, "OK"
    end
end

local function loadSavedKey()
    if not FS then return nil end
    local ok, c = pcall(function()
        if isfile(KEY_FILE) then return readfile(KEY_FILE) end
    end)
    if ok and c and c ~= "" then return c end
    return nil
end

local function saveKey(k)
    if not FS then return end
    pcall(function()
        if not isfolder("XYLO") then makefolder("XYLO") end
        writefile(KEY_FILE, k)
    end)
end

local function clearSavedKey()
    if not FS then return end
    pcall(function() if isfile(KEY_FILE) then delfile(KEY_FILE) end end)
end

local savedKey = loadSavedKey()
local autoPass = false
if savedKey then
    local ok, reason = verifyKey(savedKey, false)
    if ok then
        getgenv().SCRIPT_KEY = savedKey
        autoPass = true
        print("[XYLO] Saved key valid. Skipping key UI.")
    else
        print("[XYLO] Saved key invalid: " .. tostring(reason))
        clearSavedKey()
        savedKey = nil
    end
end

