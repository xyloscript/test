        if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then
            local d=input.Position-dragStart
            local xS = startPos.X.Scale
            local xO = startPos.X.Offset + d.X
            local yS = startPos.Y.Scale
            local yO = startPos.Y.Offset + d.Y
            frame.Position=UDim2.new(xS, xO, yS, yO)
        end
    end)
    fn()
end

if autoPass == true then
    getgenv().SCRIPT_KEY = savedKey
    if Arqel.Callbacks and Arqel.Callbacks.OnSuccess then 
        Arqel.Callbacks.OnSuccess() 
    end
else
    Arqel:Launch()
end
